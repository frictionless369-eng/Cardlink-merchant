# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://cardlink-merchant-gilt.vercel.app"
NEXT_PUBLIC_APP_URL="https://cardlink-merchant-gilt.vercel.app"

# Firebase Client Configuration (for Vercel / external deployments)
NEXT_PUBLIC_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"

# CARDLINK_SECRET: Shared secret for Cardlink API.
CARDLINK_SECRET="MY_CARDLINK_SECRET"

# CARDLINK_MERCHANT_ID: Merchant ID provided by Cardlink.
CARDLINK_MERCHANT_ID="MY_MERCHANT_ID"

# CARDLINK_PRIMARY_URL: Endpoint for MPI requests.
CARDLINK_PRIMARY_URL="https://eurocommerce-test.cardlink.gr/vpos/shophandlermpi"

# CARDLINK_SECONDARY_URL: Endpoint for XML API requests.
CARDLINK_SECONDARY_URL="https://eurocommerce-test.cardlink.gr/vpos/xmlpayvpos"

# VISA_DIRECT_API_KEY: Visa Developer Center API key / User ID for Visa Direct OCT payouts.
VISA_DIRECT_API_KEY="MY_VISA_DIRECT_API_KEY"
VISA_DIRECT_API_SECRET="MY_VISA_DIRECT_SHARED_SECRET"
VISA_DIRECT_ENDPOINT="https://sandbox.api.visa.com/visadirect/fundstransfer/v1/pushfundstransactions"

# MASTERCARD_SEND_API_KEY: Mastercard Developers consumer key for Mastercard Send disbursements.
MASTERCARD_SEND_CONSUMER_KEY="MY_MASTERCARD_SEND_CONSUMER_KEY"
MASTERCARD_SEND_ENDPOINT="https://sandbox.api.mastercard.com/send/v1/partners/disbursements/payment-transfers"
