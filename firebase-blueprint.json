{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated merchant user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "role": { "type": "string", "enum": ["merchant", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Merchant": {
      "title": "Merchant",
      "description": "Merchant account, gateway settings, and settlement balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Merchant UID" },
        "balance": { "type": "number", "description": "Current settled balance" },
        "currency": { "type": "string", "description": "ISO currency code (e.g. USD, EUR)" },
        "cardlinkMerchantId": { "type": "string", "description": "Cardlink MID" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last balance update" },
        "payoutRecipient": {
          "type": "object",
          "description": "Recipient card or bank account details for settlement and funds transfer testing",
          "properties": {
            "type": { "type": "string", "enum": ["card", "bank"] },
            "bankName": { "type": "string" },
            "accountHolder": { "type": "string" },
            "accountNumber": { "type": "string" },
            "routingOrSwift": { "type": "string" },
            "cardHolderName": { "type": "string" },
            "cardNumber": { "type": "string" },
            "cardExpiry": { "type": "string" },
            "currency": { "type": "string" }
          }
        },
        "payoutCredentials": {
          "type": "object",
          "description": "Production credentials for Visa Direct & Mastercard Send",
          "properties": {
            "visaApiKey": { "type": "string" },
            "visaSharedSecret": { "type": "string" },
            "mastercardConsumerKey": { "type": "string" },
            "visaEnvironment": { "type": "string", "enum": ["sandbox", "production"] },
            "mastercardEnvironment": { "type": "string", "enum": ["sandbox", "production"] }
          }
        },
        "keytoolCertificates": {
          "type": "array",
          "description": "Installed TLS mutual authentication (mTLS) certificates promoted for Visa Direct and Mastercard Send production networks",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "balance", "currency"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable financial transaction ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction/order ID" },
        "date": { "type": "string", "format": "date-time", "description": "Transaction timestamp" },
        "amount": { "type": "number", "description": "Transaction amount" },
        "currency": { "type": "string", "description": "ISO currency code" },
        "status": { "type": "string", "enum": ["Completed", "Pending", "Failed", "Cancelled"], "description": "Transaction status" },
        "type": { "type": "string", "enum": ["payment", "capture", "cancel", "refund", "payout", "funds_transfer"], "description": "Ledger entry type" },
        "entryMethod": { "type": "string", "enum": ["HOSTED_REDIRECT", "MANUAL_PAN_KEYPAD", "VISA_DIRECT_PUSH", "MASTERCARD_SEND_PUSH", "BANK_TRANSFER"], "description": "Payment capture or disbursement method" },
        "gateway": { "type": "string", "description": "Acquiring or payout network (CARDLINK_VPOS, VISA_DIRECT, MASTERCARD_SEND)" },
        "cardBrand": { "type": "string", "description": "Card scheme (VISA, MASTERCARD, etc.)" },
        "maskedPan": { "type": "string", "description": "Masked PAN (last 4 digits)" },
        "recipientName": { "type": "string", "description": "Name of the payout recipient" },
        "merchantId": { "type": "string", "description": "ID of the merchant" }
      },
      "required": ["id", "date", "amount", "status", "merchantId"]
    },
    "WebhookLog": {
      "title": "WebhookLog",
      "description": "Audit trail of incoming Cardlink webhook callback events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Event timestamp" },
        "status": { "type": "string", "enum": ["success", "failure"], "description": "Log status" },
        "event": { "type": "string", "description": "Event name (payment, capture, cancel, etc.)" },
        "payload": { "type": "object", "description": "Raw callback payload" },
        "error": { "type": "string", "description": "Optional error message" },
        "merchantId": { "type": "string", "description": "ID of the merchant" }
      },
      "required": ["id", "timestamp", "status", "event", "merchantId"]
    },
    "Room": {
      "title": "Room",
      "description": "Persistent resort room showcase tier with image asset metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Room ID" },
        "name": { "type": "string", "description": "Room suite title" },
        "price": { "type": "number", "description": "Price per night" },
        "image": { "type": "string", "description": "Image asset path/URL" },
        "description": { "type": "string", "description": "Suite description" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last modified timestamp" }
      },
      "required": ["id", "name", "price", "image"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores authenticated user profiles."
    },
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Stores merchant account balances and gateway settings."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Stores transaction ledger records."
    },
    "/webhook_logs/{logId}": {
      "schema": "WebhookLog",
      "description": "Stores webhook callback audit logs."
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Stores persistent room showcase tiers and image metadata."
    }
  }
}
